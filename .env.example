# Local development values only. Never put real secrets in this file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Central database. Tenant databases are resolved through the tenant registry.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_CENTRAL_DB=unified_central

REDIS_URL=redis://localhost:6379

# Key of the old apps' XOR device token (TOKEN_KEY in the old backends). Dev value only.
LEGACY_TOKEN_KEY=dev-legacy-token-key
ANDROID_SIGNING_SECRET=dev-android-signing-secret
ANDROID_AES_NEW_SECRET=dev-android-aes-secret
