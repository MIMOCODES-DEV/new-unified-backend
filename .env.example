# Local development values only. Never put real secrets in this file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Central database. Tenant databases are resolved through the tenant registry.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_CENTRAL_DB=unified_central

REDIS_URL=redis://localhost:6379

# Master key that encrypts per-brand secrets (32 random bytes, base64). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This one is for local development only. Changing it makes stored secrets unreadable.
TENANT_SECRETS_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2LTE=
