{
  "name": "unified-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Unified multi-tenant backend for all player apps",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.api.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.worker.ts",
    "cli": "node --env-file-if-exists=.env --import @swc-node/register/esm-register src/main.cli.ts",
    "e2e:devices": "node tools/dev/e2e-devices.mjs",
    "e2e:playlists": "node tools/dev/e2e-playlists.mjs",
    "e2e:licenses": "node tools/dev/e2e-licenses.mjs",
    "e2e:v4": "node tools/dev/e2e-v4.mjs",
    "seed": "pnpm cli migrate:central && pnpm cli tenants:seed --dev && pnpm cli migrate:tenants && pnpm cli playlists:pin-keys && pnpm cli seed:examples",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.spec.ts\"",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "prepare": "husky",
    "knip": "knip"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-captcha": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.3",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.5",
    "bcryptjs": "2.4.3",
    "crypto-js": "4.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
